    {
      "id": "TjTQ1D9Cy1bxCQsOJHkri",
      "type": "text",
      "x": 264.9084157792345,
      "y": 354.76106770833326,
      "width": 302.35960315522686,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
