# Tenderly Virtual TestNets (forks)
TENDERLY_ETHEREUM_FORK_VNET_ID=<your-api-key>
TENDERLY_BASE_FORK_VNET_ID=<your-api-key>
TENDERLY_ARBITRUM_FORK_VNET_ID=<your-api-key>
STAGE_TENDERLY_VIRTUAL_TESTNET_API_KEY=<your-api-key>

# Block explorer verification (make verify / make verify-all)
# A single Etherscan V2 key covers Ethereum, Optimism, Base, Arbitrum, and Sepolia.
ETHERSCAN_API_KEY=<your-api-key>

# API key for non-Etherscan verifiers that require one (oklink, custom, or a
# key-gated explorer). Not needed for sourcify or most blockscout.
# VERIFIER_API_KEY=<your-api-key>
